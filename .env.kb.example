# Database
DATABASE_URL=postgresql+psycopg2://iris:iris@localhost:5432/iris

# Embeddings (기본: OpenAI)
EMBED_PROVIDER=OPENAI
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-large
# (선택/레거시) Google Embedding 사용 시
# EMBED_PROVIDER=GOOGLE
# GOOGLE_API_KEY=your_google_api_key

# LLM (ask_llm / rerank / general / summary)
KB_LLM_MODEL=gpt-4.1-mini
# KB_RERANK_MODEL=gpt-4.1-mini
# KB_GENERAL_MODEL=gpt-4.1-mini
# KB_CHAT_SUMMARY_MODEL=gpt-4.1-mini

# Collector auth (paste browser cookies for cafe.naver.com if needed)
CAFE_COOKIES=

# Target cafe (dinohighclass) and menus (comma-separated menu IDs)
KB_CAFE_ID=30819883
# Recommended default menus for KB crawl
KB_MENUS=23,32,42,33,206,136,51,48,62,245
