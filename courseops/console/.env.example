# CourseOps Console (Vercel)

# 로그인(공용 비번)
COURSEOPS_SHARED_PASSWORD=

# 새 강의 등록 관리자(콤마로 여러 명 가능)
# 예: COURSEOPS_ADMIN_NAMES=홍길동,김철수
COURSEOPS_ADMIN_NAMES=

# 세션 쿠키 서명(길게 랜덤)
COURSEOPS_SESSION_SECRET=

# Postgres (Vercel Postgres/Supabase/Neon 등)
DATABASE_URL=

# Google Sheets read-only 서비스 계정 JSON (문자열 1개로 저장)
# - Vercel에서는 JSON 전체를 그대로 붙여넣거나, private_key의 \n 처리를 주의한다.
GOOGLE_SERVICE_ACCOUNT_JSON=

# 로컬 에이전트 인증 토큰(콘솔/에이전트 동일)
COURSEOPS_AGENT_TOKEN=
