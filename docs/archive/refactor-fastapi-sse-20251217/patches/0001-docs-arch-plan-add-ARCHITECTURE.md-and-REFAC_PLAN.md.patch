+                            self._log(f"메뉴 {menu_id} 페이지 {page_idx}: 신규 {len(new_items)}건 (누적 {len(summaries)})")
+                            summaries.extend(new_items)
+                            empty_count = 0
+                        else:
+                            empty_count += 1
+                            self._log(f"메뉴 {menu_id} 페이지 {page_idx}: 신규 게시글 없음 (연속 {empty_count})")
+
+                        if empty_count >= 2:
+                            self._log(f"메뉴 {menu_id}: 연속 빈 페이지 탐지, 목록 수집 종료")
