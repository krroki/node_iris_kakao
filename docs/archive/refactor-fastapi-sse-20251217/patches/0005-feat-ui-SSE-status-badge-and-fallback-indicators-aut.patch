   python3 "$ROOT_DIR/scripts/log_api.py" >> "$LOG_DIR/log_api.log" 2>&1 &
 
+# (Re)start FastAPI realtime server (8600) if uvicorn available (temporary; will ensure below)
+if command -v uvicorn >/dev/null 2>&1; then
+  pkill -f "uvicorn .*server\.app:app" >/dev/null 2>&1 || true
+  nohup env REALTIME_API_HOST=0.0.0.0 REALTIME_API_PORT=8600 IRIS_LOGS_DIR="$ROOT_DIR/node-iris-app/data/logs" \
+    uvicorn server.app:app --host 0.0.0.0 --port 8600 >> "$LOG_DIR/realtime_api.log" 2>&1 &
+fi
+
 if [[ ! -x "$PY" ]]; then
   echo "[ui] venv not found; creating..." | tee -a "$LOG_FILE"
   python3 -m venv "$VENV"
   "$PY" -m pip install --upgrade pip wheel setuptools
-  "$PY" -m pip install streamlit pandas plotly
+  "$PY" -m pip install streamlit pandas plotly fastapi uvicorn
+else
+  # Ensure packages are present
+  "$PY" - << 'PY'
+try:
+    import streamlit, pandas, plotly, fastapi, uvicorn  # noqa: F401
+except Exception:
+    import sys, subprocess
+    subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'streamlit', 'pandas', 'plotly', 'fastapi', 'uvicorn'])
+PY
 fi
 
 # Ensure no stale Streamlit instance on the selected port
@@ -62,3 +78,8 @@ nohup env NODE_IRIS_APP_DIR="$NODE_IRIS_APP_DIR" \
   >> "$LOG_FILE" 2>&1 &
 disown || true
 echo "[ui] started. tail -f $LOG_FILE" | tee -a "$LOG_FILE"
+
+# Now (re)start Realtime API within this venv to ensure availability
+pkill -f "uvicorn .*server\.app:app" >/dev/null 2>&1 || true
+nohup env REALTIME_API_HOST=0.0.0.0 REALTIME_API_PORT=8600 IRIS_LOGS_DIR="$ROOT_DIR/node-iris-app/data/logs" \
+  "$VENV/bin/uvicorn" server.app:app --host 0.0.0.0 --port 8600 >> "$LOG_DIR/realtime_api.log" 2>&1 &
