diff --git a/web/src/app/api/status/route.ts b/web/src/app/api/status/route.ts
new file mode 100644
index 00000000..dd80f5c1
--- /dev/null
+++ b/web/src/app/api/status/route.ts
@@ -0,0 +1,249 @@
+export const runtime = 'nodejs';
+
+import { NextResponse } from 'next/server';
+import path from 'path';
+import { promises as fs } from 'fs';
+import { promisify } from 'util';
+import { exec } from 'child_process';
+
+type StageKey = 'device' | 'bot' | 'logStore' | 'realtime' | 'ui';
+
+type StageStatus = {
+  key: StageKey;
+  name: string;
+  ok: boolean;
+  detail: string;
+  timestamp?: string | null;
+  extra?: Record<string, unknown>;
+};
+
+type StatusResponse = {
+  updatedAt: string;
+  stages: Record<StageKey, StageStatus>;
+  latestLogTs?: string | null;
+};
+
+const ROOT = path.resolve(process.cwd(), '..');
+const BOT_STATUS_FILE = path.join(ROOT, 'node-iris-app', 'data', 'status.json');
+const LOGS_DIR = path.join(ROOT, 'node-iris-app', 'data', 'logs');
+
+const execAsync = promisify(exec);
+
+async function readDeviceStatus(): Promise<StageStatus> {
+  const stage: StageStatus = {
+    key: 'device',
+    name: 'Redroid / IRIS 단말',
+    ok: false,
+    detail: 'ADB 상태 확인 대기 중',
+  };
+
+  try {
+    const { stdout } = await execAsync('adb devices', { timeout: 5000 });
+    const lines = stdout
+      .split('\n')
+      .map((line) => line.trim())
+      .filter((line) => line && !line.toLowerCase().startsWith('list of devices'));
+    const devices = lines
+      .map((line) => {
+        const parts = line.split(/\s+/);
+        return { id: parts[0], state: parts[1] || '' };
+      })
+      .filter((d) => !!d.id);
+    const connected = devices.filter((d) => d.state === 'device');
+    stage.ok = connected.length > 0;
+    stage.detail = stage.ok
+      ? `ADB 연결 단말 ${connected.length}개 (${connected.map((d) => d.id).join(', ')})`
+      : 'adb devices에 연결된 단말이 없습니다.';
+    stage.extra = { devices };
+    stage.timestamp = new Date().toISOString();
+  } catch (error: any) {
+    stage.ok = false;
+    stage.detail = `adb devices 실패: ${error?.message || error}`;
+  }
+
+  return stage;
+}
+
+function describeAge(msDiff: number | null): string {
+  if (msDiff == null) return '시간 정보를 알 수 없음';
+  const sec = Math.max(0, Math.round(msDiff / 1000));
+  if (sec < 60) return `${sec}s 전`;
+  const min = Math.floor(sec / 60);
+  if (min < 60) return `${min}m 전`;
+  const hr = Math.floor(min / 60);
+  return `${hr}h 전`;
+}
+
+async function readBotStatus(): Promise<StageStatus> {
+  const stage: StageStatus = {
+    key: 'bot',
+    name: 'Node-IRIS Bot',
+    ok: false,
+    detail: '상태 파일을 아직 읽지 못했음',
+  };
+
+  try {
+    const raw = await fs.readFile(BOT_STATUS_FILE, 'utf-8');
+    const data = JSON.parse(raw || '{}');
+    const lastEventTs = typeof data.lastEventTs === 'string' ? data.lastEventTs : null;
+    const startedAt = typeof data.startedAt === 'string' ? data.startedAt : null;
+
+    if (!lastEventTs) {
+      // 프로세스는 떠 있지만, 아직 단 한 건의 이벤트도 기록되지 않은 상태
+      stage.ok = false;
+      stage.timestamp = startedAt ?? null;
+      stage.detail = startedAt
+        ? `아직 수신된 이벤트가 없습니다 (시작: ${new Date(startedAt).toISOString()})`
+        : '아직 수신된 이벤트가 없습니다';
+      stage.extra = {
+        pid: data.pid ?? null,
+        lastEventText: null,
+      };
+      return stage;
+    }
+
+    const tsDate = new Date(lastEventTs);
+    const ageMs = Date.now() - tsDate.getTime();
+    const healthy = ageMs < 90_000; // < 90초이면 정상
+    stage.ok = healthy;
+    stage.timestamp = tsDate.toISOString();
+    stage.detail = healthy
+      ? `최근 이벤트 ${describeAge(ageMs)} (${data.lastEventRoomId || 'room n/a'})`
+      : '최근 이벤트가 일정 시간 이상 들어오지 않았습니다.';
+    stage.extra = {
+      pid: data.pid ?? null,
+      lastEventText: data.lastEventText ?? null,
+    };
+  } catch (error: any) {
+    stage.ok = false;
+    stage.detail = `status.json을 읽지 못했습니다: ${error?.message || error}`;
+  }
+
+  return stage;
+}
+
+async function readLogStatus(): Promise<{ stage: StageStatus; latestTs: string | null }> {
+  const stage: StageStatus = {
+    key: 'logStore',
+    name: 'Log Store',
+    ok: false,
+    detail: '로그 디렉토리를 확인 중',
+  };
+
+  let latestTs: string | null = null;
+  let latestMs = 0;
+
+  try {
+    // 1) status.json 의 lastEventTs 기준으로 최신 로그 시각 계산
+    try {
+      const raw = await fs.readFile(BOT_STATUS_FILE, 'utf-8');
+      const data = JSON.parse(raw || '{}');
+      const last = data.lastEventTs as string | undefined;
+      if (typeof last === 'string' && last) {
+        const ts = Date.parse(last);
+        if (!Number.isNaN(ts)) {
+          latestMs = ts;
+          latestTs = new Date(ts).toISOString();
+        }
+      }
+    } catch {}
+
+    // 2) 보조: 로그 디렉토리 파일 mtime 스캔
+    if (!latestMs) {
+      const roomDirs = await fs.readdir(LOGS_DIR, { withFileTypes: true });
+      for (const dir of roomDirs) {
+        if (!dir.isDirectory()) continue;
+        const roomPath = path.join(LOGS_DIR, dir.name);
+        const files = await fs.readdir(roomPath);
+        for (const file of files) {
+          if (!file.endsWith('.log')) continue;
+          const filePath = path.join(roomPath, file);
+          const stat = await fs.stat(filePath);
+          if (stat.mtimeMs > latestMs) {
+            latestMs = stat.mtimeMs;
+            latestTs = new Date(stat.mtimeMs).toISOString();
+          }
+        }
+      }
+    }
+
+    if (latestMs === 0) {
+      stage.ok = false;
+      stage.detail = '로그 파일이 없거나 아직 한 건도 기록되지 않았습니다.';
+    } else {
+      const ageMs = Date.now() - latestMs;
+      // 로그가 "얼마나 최근에" 들어왔는지 기준으로 건강 상태 판단 (10분 이내만 OK)
+      const staleMs = 10 * 60 * 1000;
+      stage.ok = ageMs < staleMs;
+      stage.timestamp = latestTs;
+      stage.detail = stage.ok
+        ? `최근 로그 ${describeAge(ageMs)}`
+        : `로그가 ${describeAge(ageMs)} 동안 들어오지 않고 있습니다.`;
+    }
+  } catch (error: any) {
+    stage.ok = false;
+    stage.detail = `로그 상태를 확인하지 못했습니다: ${error?.message || error}`;
+  }
+
+  return { stage, latestTs };
+}
+
+async function readRealtimeStatus(): Promise<StageStatus> {
+  const stage: StageStatus = {
+    key: 'realtime',
+    name: 'Realtime API (FastAPI)',
+    ok: false,
+    detail: '상태 확인 대기 중',
+  };
+
+  try {
+    // FastAPI /health 는 Next /api/health 경유로 확인
+    const res = await fetch('http://127.0.0.1:3000/api/health', { cache: 'no-store' });
+    if (!res.ok) {
+      stage.detail = `HTTP ${res.status}`;
+      return stage;
+    }
+    const data = await res.json();
+    const lastAgeSec = data?.bot?.lastEventAgeSec;
+    stage.ok = !!data?.ok;
+    stage.detail = stage.ok
+      ? `Rooms ${data?.rooms ?? 0} · Bot 이벤트 ${lastAgeSec ?? '?'}s 전`
+      : 'FastAPI가 불안정한 상태입니다.';
+    stage.timestamp = data?.bot?.lastEventTs || null;
+    stage.extra = data;
+  } catch (error: any) {
+    stage.ok = false;
+    stage.detail = `연결 실패: ${error?.message || error}`;
+  }
+
+  return stage;
+}
+
+export async function GET() {
+  const stages: StatusResponse['stages'] = {
+    device: await readDeviceStatus(),
+    bot: await readBotStatus(),
+    logStore: { key: 'logStore', name: 'Log Store', ok: false, detail: '' },
+    realtime: { key: 'realtime', name: 'Realtime API (FastAPI)', ok: false, detail: '' },
+    ui: {
+      key: 'ui',
+      name: 'Dashboard (Next.js)',
+      ok: true,
+      detail: '현재 페이지가 정상적으로 열려 있습니다.',
+    },
+  };
+
+  const logInfo = await readLogStatus();
+  stages.logStore = logInfo.stage;
+
+  stages.realtime = await readRealtimeStatus();
+
+  const payload: StatusResponse = {
+    updatedAt: new Date().toISOString(),
+    stages,
+    latestLogTs: logInfo.latestTs,
+  };
+
+  return NextResponse.json(payload, { headers: { 'Cache-Control': 'no-store' } });
+}
