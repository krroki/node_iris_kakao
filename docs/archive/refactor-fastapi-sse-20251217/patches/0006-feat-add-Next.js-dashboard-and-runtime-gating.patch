+++ b/web/src/app/kb/page.tsx
@@ -0,0 +1,287 @@
+"use client";
+import { useCallback, useEffect, useRef, useState } from "react";
+import '../dashboard.css';
+
+const API = {
+  stats: "/api/kb/stats",
+  run: "/api/kb/run",
+  run_cookie: "/api/kb/run_cookie",
+  login: "/api/kb/login",
+  creds: "/api/kb/creds",
+  schedule: "/api/kb/schedule",
+};
+
+type JobRow = {
+  job_id: number;
+  job_type: string;
+  status: string;
+  started_at: string;
+  finished_at?: string;
+  payload?: any;
+  result?: any;
+};
+
+function useAbortableFetch() {
+  const ctrl = useRef<AbortController | null>(null);
+  useEffect(() => () => { ctrl.current?.abort(); }, []);
+  return useCallback(async (url: string, init?: RequestInit & { timeoutMs?: number }) => {
+    ctrl.current?.abort();
+    const c = new AbortController();
+    ctrl.current = c;
+    const { timeoutMs = 6000, ...rest } = init || {};
+    const t = setTimeout(() => c.abort(), timeoutMs);
+    try {
+      const r = await fetch(url, { cache: "no-store", ...rest, signal: c.signal });
+      const ct = r.headers.get("content-type") || "";
+      const body = ct.includes("application/json") ? await r.json() : await r.text();
+      return { ok: r.ok, status: r.status, body } as const;
+    } catch (e: any) {
+      const msg = e?.name === "AbortError" ? "timeout" : (e?.message || String(e));
+      return { ok: false, status: 0, body: { ok: false, code: "fetch_failed", detail: msg } } as const;
+    } finally { clearTimeout(t); }
+  }, []);
+}
+
+export default function KBPage() {
+  const [loading, setLoading] = useState(false);
+  const [stats, setStats] = useState<any>(null);
+  const [schedule, setScheduleState] = useState<any>(null);
+  const [msg, setMsg] = useState<string>("");
+  const [nid, setNid] = useState("");
+  const [npw, setNpw] = useState("");
+  const [save, setSave] = useState(true);
+  const [hasSaved, setHasSaved] = useState<any>(null);
+  const [detail, setDetail] = useState<{ title: string; json: any } | null>(null);
+
+  const fetchx = useAbortableFetch();
+
+  const refresh = useCallback(async () => {
+    const [rs, sch] = await Promise.all([
+      fetchx(API.stats, { timeoutMs: 8000 }),
+      fetchx(API.schedule, { timeoutMs: 8000 }),
+    ]);
+    if (rs.ok) setStats(rs.body); else setMsg(`stats failed: ${JSON.stringify(rs.body)}`);
+    if (sch.ok) setScheduleState(sch.body);
+  }, [fetchx]);
+
+  useEffect(() => {
+    refresh();
+    (async () => {
+      try { const r = await fetch(API.creds, { cache: "no-store" }); const j = await r.json(); setHasSaved(j); } catch { }
+    })();
+  }, [refresh]);
+
+  const run = async (task: "collect" | "embed" | "manual", extra: any = {}) => {
+    setLoading(true); setMsg("");
+    try {
+      const r = await fetchx(API.run, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ task, ...extra }), timeoutMs: 8000 });
+      setMsg(`${task} -> ${typeof r.body === 'string' ? r.body : JSON.stringify(r.body)}`);
+      setTimeout(refresh, 1200);
+    } finally { setLoading(false); }
+  };
+
+  const doLogin = async () => {
+    setLoading(true); setMsg("");
+    try {
+      if (save && nid && npw) {
+        const s = await fetchx(API.creds, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: nid, pw: npw }) });
+        if (!s.ok) { setMsg(`save creds failed: ${JSON.stringify(s.body)}`); return; }
+      }
+      if (nid && npw) {
+        const r = await fetchx(API.login, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: nid, pw: npw, headless: false }), timeoutMs: 180000 });
+        if (!r.ok || (typeof r.body !== 'string' && (r.body as any)?.ok === false)) {
+          const rc = await fetchx(API.run_cookie, { method: "POST", timeoutMs: 8000 });
+          setMsg(`login fallback cookie: ${JSON.stringify(rc.body)}`);
+        } else { setMsg(`login ok`); }
+      } else {
+        const rc = await fetchx(API.run_cookie, { method: "POST", timeoutMs: 8000 });
+        setMsg(`cookie: ${JSON.stringify(rc.body)}`);
+      }
+      setTimeout(refresh, 1200);
+    } finally { setLoading(false); }
+  };
+
+  const counts = stats?.counts || {};
+  const jobs: JobRow[] = stats?.jobs || [];
+  const cookieBadge = stats?.cookies?.present ? `쿠키 등록됨 · ${stats?.cookies?.updated_at?.replace('T', ' ').slice(0, 19)}` : '쿠키 없음';
+
+  async function setSchedule(task: 'collect' | 'embed' | 'manual', minutes: number) {
+    setLoading(true);
+    try {
+      await fetch(API.schedule, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ task, interval_minutes: minutes }) });
+    } finally { setLoading(false); refresh(); }
+  }
+
+  return (
+    <div className="dashboard-container">
+      <div className="header-section">
+        <div>
+          <h1 className="main-title">카페 지식베이스</h1>
+          <p className="sub-title">네이버 카페 게시글을 수집하고 임베딩하여 지식베이스를 구축합니다.</p>
+        </div>
+        <div style={{ display: 'flex', gap: 12 }}>
+          <button disabled={loading} onClick={refresh} className="btn-outline">새로고침</button>
+        </div>
+      </div>
+
+      {msg && (
+        <div style={{ marginBottom: 24, padding: 12, background: 'rgba(59,130,246,0.1)', border: '1px solid rgba(59,130,246,0.2)', borderRadius: 8, color: '#93c5fd', whiteSpace: 'pre-wrap', fontSize: 13 }}>
+          {msg}
+        </div>
+      )}
+
+      <div className="pipeline-card">
+        <div className="pipeline-header">
+          <div className="pipeline-title">작업 실행</div>
+          <div style={{ fontSize: 12, color: stats?.cookies?.present ? 'var(--success)' : 'var(--error)' }}>{cookieBadge}</div>
+        </div>
+        <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap' }}>
+          <button disabled={loading} onClick={() => run('collect')} className="btn-copy">수집 실행</button>
+          <button disabled={loading} onClick={() => run('collect', { pages: 1 })} className="btn-outline">빠른 수집(1p)</button>
+          <button disabled={loading} onClick={() => run('embed')} className="btn-outline">임베드 업데이트</button>
+          <button disabled={loading} onClick={() => run('manual')} className="btn-outline">매뉴얼화 실행</button>
+        </div>
+      </div>
+
+      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: 16, marginBottom: 32 }}>
+        <Metric label="포스트" value={counts.posts || 0} />
+        <Metric label="매뉴얼" value={counts.manuals || 0} />
+        <Metric label="임베드(포스트)" value={counts.emb_posts || 0} />
+        <Metric label="임베드(매뉴얼)" value={counts.emb_manuals || 0} />
+      </div>
+
+      <div className="pipeline-card">
+        <div className="pipeline-header">
+          <div className="pipeline-title">스케줄 설정</div>
+        </div>
+        <div style={{ display: 'grid', gridTemplateColumns: '120px 1fr auto', gap: 12, alignItems: 'center' }}>
+          {(['collect', 'embed', 'manual'] as const).map(t => (
+            <div key={t} style={{ display: 'contents' }}>
+              <div style={{ color: 'var(--text-primary)', fontWeight: 600 }}>{t}</div>
+              <div style={{ fontSize: 13, color: 'var(--text-secondary)' }}>
+                interval: {schedule?.schedule?.[t]?.interval_minutes ?? 0}m, next: {schedule?.schedule?.[t]?.next ? fmt(schedule?.schedule?.[t]?.next) : '-'}
+              </div>
+              <div style={{ display: 'flex', gap: 6 }}>
+                <button disabled={loading} onClick={() => setSchedule(t, 0)} className="btn-outline" style={{ color: 'var(--error)', borderColor: 'var(--error)' }}>중지</button>
+                <button disabled={loading} onClick={() => setSchedule(t, 5)} className="btn-outline">5분</button>
+                <button disabled={loading} onClick={() => setSchedule(t, 30)} className="btn-outline">30분</button>
+              </div>
+            </div>
+          ))}
+        </div>
+      </div>
+
+      <div className="pipeline-card">
+        <div className="pipeline-header">
+          <div className="pipeline-title">자동 로그인 / 쿠키 캡처</div>
+        </div>
+        <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
+          <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
+            <input value={nid} onChange={e => setNid(e.target.value)} placeholder="아이디" className="filter-input" style={{ width: 200 }} />
+            <input value={npw} onChange={e => setNpw(e.target.value)} placeholder="비밀번호" type="password" className="filter-input" style={{ width: 200 }} />
+            <button disabled={loading || (!hasSaved?.saved && (!nid || !npw))} onClick={doLogin} className="btn-copy">로그인/쿠키 캡처</button>
+          </div>
+          <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
+            <label style={{ fontSize: 13, color: 'var(--text-secondary)', display: 'flex', alignItems: 'center', gap: 6, cursor: 'pointer' }}>
+              <input type='checkbox' checked={save} onChange={e => setSave(e.target.checked)} style={{ width: 16, height: 16, accentColor: 'var(--accent-primary)' }} />
+              서버에 자격 저장
+            </label>
+            {hasSaved?.saved && <span style={{ fontSize: 12, color: 'var(--text-muted)' }}>저장됨: {hasSaved.id_masked}</span>}
+          </div>
+          <div style={{ color: 'var(--text-muted)', fontSize: 12 }}>입력값은 서버에 평문으로 보관하지 않고, 로그인 성공 시 쿠키로 DB에 저장/교체됩니다.</div>
+        </div>
+      </div>
+
+      <div className="section-title">최근 작업</div>
+      <div style={{ border: '1px solid var(--border-color)', borderRadius: 12, overflow: 'hidden', background: 'var(--bg-card)' }}>
+        <table style={{ width: '100%', borderCollapse: 'collapse' }}>
+          <thead>
+            <tr style={{ background: 'var(--bg-card-hover)', borderBottom: '1px solid var(--border-color)' }}>
+              <Th>ID</Th><Th>종류</Th><Th>상태</Th><Th>시작</Th><Th>종료</Th><Th>결과</Th>
+            </tr>
+          </thead>
+          <tbody>
+            {jobs.map(j => (
+              <tr key={j.job_id} style={{ borderBottom: '1px solid var(--border-color)' }}>
+                <Td>{j.job_id}</Td>
+                <Td>{j.job_type}</Td>
+                <Td>{j.status}</Td>
+                <Td>{fmt(j.started_at)}</Td>
+                <Td>{j.finished_at ? fmt(j.finished_at) : '-'}</Td>
+                <Td>
+                  {j.result ? (
+                    <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
+                      <span title={typeof j.result === 'string' ? j.result : JSON.stringify(j.result)} style={{ maxWidth: 200, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', display: 'block' }}>
+                        {summary(j.result)}
+                      </span>
+                      <button className="btn-outline" style={{ padding: '2px 8px', fontSize: 11 }} onClick={() => setDetail({ title: `Job #${j.job_id} (${j.job_type})`, json: { payload: j.payload, result: j.result } })}>자세히</button>
+                    </div>
+                  ) : (<span style={{ color: 'var(--text-muted)' }}>—</span>)}
+                </Td>
+              </tr>
+            ))}
+            {!jobs.length && (
+              <tr><Td colSpan={6} style={{ color: 'var(--text-muted)', textAlign: 'center', padding: 20 }}>기록 없음</Td></tr>
+            )}
+          </tbody>
+        </table>
+      </div>
+
+      {detail && (
+        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.6)', backdropFilter: 'blur(4px)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 100 }} onClick={() => setDetail(null)}>
+          <div style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)', borderRadius: 16, padding: 24, maxWidth: 820, width: '90%', maxHeight: '80vh', overflow: 'auto', boxShadow: '0 20px 25px -5px rgba(0,0,0,0.1)' }} onClick={e => e.stopPropagation()}>
+            <div style={{ display: 'flex', alignItems: 'center', marginBottom: 16 }}>
+              <div style={{ fontWeight: 800, fontSize: 18, color: 'var(--text-primary)' }}>{detail.title}</div>
+              <button className="btn-outline" style={{ marginLeft: 'auto' }} onClick={() => setDetail(null)}>닫기</button>
+            </div>
+            <pre style={{ whiteSpace: 'pre-wrap', fontSize: 13, color: 'var(--text-secondary)', background: 'var(--bg-main)', padding: 16, borderRadius: 8, overflow: 'auto' }}>{JSON.stringify(detail.json, null, 2)}</pre>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function Metric({ label, value }: { label: string, value: any }) {
+  return (
+    <div style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)', borderRadius: 16, padding: 20 }}>
+      <div style={{ color: 'var(--text-secondary)', fontSize: 13, marginBottom: 4 }}>{label}</div>
+      <div style={{ fontSize: 28, fontWeight: 800, color: 'var(--text-primary)' }}>{value}</div>
+    </div>
+  );
+}
+
+function Th({ children }: { children: any }) { return <th style={{ textAlign: 'left', padding: '12px 16px', color: 'var(--text-secondary)', fontSize: 13, fontWeight: 600 }}>{children}</th>; }
+function Td(
+  { children, colSpan, style }: { children: any; colSpan?: number; style?: React.CSSProperties }
+) {
+  return <td colSpan={colSpan} style={{ padding: '12px 16px', fontSize: 13, color: 'var(--text-primary)', ...(style || {}) }}>{children}</td>;
+}
+
+function fmt(s: string) { try { const d = new Date(s); return d.toLocaleString('ko-KR', { hour12: false }); } catch { return s; } }
+
+function summary(result: any) {
+  try {
+    if (!result) return '—';
+    const r = typeof result === 'string' ? JSON.parse(result) : result;
+    if (r.summary && typeof r.summary === 'object') {
+      const s = r.summary as any;
+      const parts: string[] = [];
+      if (s.kept != null) parts.push(`kept=${s.kept}`);
+      if (s.skipped != null) parts.push(`skipped=${s.skipped}`);
+      if (s.known != null) parts.push(`known=${s.known}`);
+      return parts.join(' ');
+    }
+    if (r.upserted != null) {
+      const parts = [`upserted=${r.upserted}`];
+      if (r.kind) parts.push(`(${r.kind})`);
+      if (r.dim != null) parts.push(`dim=${r.dim}`);
+      if (r.model) parts.push(r.model);
+      return parts.join(' ');
+    }
+    if (r.created != null) return `created=${r.created}`;
+    if (r.error) return `error: ${r.error}`;
+    const str = JSON.stringify(r);
+    return str.length > 80 ? str.slice(0, 77) + '…' : str;
+  } catch { return '—' }
+}
