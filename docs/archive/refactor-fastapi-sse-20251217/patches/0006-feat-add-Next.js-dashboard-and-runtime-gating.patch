+                            >
+                                <option value="">사용 안 함</option>
+                                {(optionsByCat[c.key] || []).map(it => (
+                                    <option key={it.category + it.name} value={it.name}>{it.title || it.name}</option>
+                                ))}
+                            </select>
+                        </div>
+                    ))}
+                </div>
+
+                <div style={{ display: 'flex', gap: 12, marginTop: 24, alignItems: 'center' }}>
+                    <button onClick={save} disabled={saving} className="btn-copy">
+                        {saving ? '저장 중...' : 'Save'}
+                    </button>
+                    {msg && <div style={{ color: 'var(--accent-primary)', fontSize: 14 }}>{msg}</div>}
+                </div>
+            </div>
+
+            <div style={{ marginTop: 20, color: 'var(--text-muted)', fontSize: 12 }}>
+                참고: 템플릿/설정 항목은 점진적으로 추가됩니다.
+            </div>
+        </div>
+    );
+}
