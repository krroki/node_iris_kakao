+  } catch(e) { log('[hook][skip] HttpURLConnection: '+e); }
+});
diff --git a/scripts/hook_capture_auth_wide.js b/scripts/hook_capture_auth_wide.js
new file mode 100644
index 00000000..a16141cf
--- /dev/null
+++ b/scripts/hook_capture_auth_wide.js
@@ -0,0 +1,48 @@
+Java.perform(function () {
+  function log(line) {
+    try { console.log(line); } catch (e) {}
+    try {
+      var FW = Java.use('java.io.FileWriter');
+      var BW = Java.use('java.io.BufferedWriter');
+      var fw = FW.$new('/sdcard/talkapi_auth.log', true);
+      var bw = BW.$new(fw);
+      bw.write(line + '\n'); bw.flush(); bw.close(); fw.close();
+    } catch (e) {}
+  }
+  function hookClassMethod(cls, method, sig){
+    try{
+      var C = Java.use(cls);
+      var overload = C[method].overload.apply(C[method], sig);
+      var orig = overload.implementation;
+      overload.implementation = function(){
+        try{
+          var n = arguments[0], v = arguments[1];
+          if(n && v && n.toString().toLowerCase()==='authorization'){
+            log('[AUTH]['+cls+'.'+method+'] '+v);
+          }
+        }catch(e){ log('[err]['+cls+'.'+method+'] '+e); }
+        return orig.apply(this, arguments);
+      };
+      log('[hook] '+cls+'.'+method+' '+sig.join(','));
+    }catch(e){ log('[hook][skip] '+cls+'.'+method+': '+e); }
+  }
+  // URLConnection
+  hookClassMethod('java.net.URLConnection','setRequestProperty',['java.lang.String','java.lang.String']);
+  hookClassMethod('java.net.URLConnection','addRequestProperty',['java.lang.String','java.lang.String']);
+  // HttpsURLConnection impls
+  hookClassMethod('com.android.okhttp.internal.huc.HttpURLConnectionImpl','setRequestProperty',['java.lang.String','java.lang.String']);
+  hookClassMethod('com.android.okhttp.internal.huc.HttpURLConnectionImpl','addRequestProperty',['java.lang.String','java.lang.String']);
+  hookClassMethod('com.android.okhttp.internal.huc.HttpsURLConnectionImpl','setRequestProperty',['java.lang.String','java.lang.String']);
+  hookClassMethod('com.android.okhttp.internal.huc.HttpsURLConnectionImpl','addRequestProperty',['java.lang.String','java.lang.String']);
+  // OkHttp headers builder (android/okhttp3)
+  hookClassMethod('com.android.okhttp.Headers$Builder','add',['java.lang.String','java.lang.String']);
+  hookClassMethod('com.android.okhttp.Headers$Builder','set',['java.lang.String','java.lang.String']);
+  hookClassMethod('okhttp3.Headers$a','add',['java.lang.String','java.lang.String']);
+  hookClassMethod('okhttp3.Headers$a','set',['java.lang.String','java.lang.String']);
+  // okhttp3 Request.Builder obfuscated aliases
+  hookClassMethod('okhttp3.Request$a','addHeader',['java.lang.String','java.lang.String']);
+  hookClassMethod('okhttp3.Request$a','header',['java.lang.String','java.lang.String']);
+  // com.android.okhttp Request.Builder
+  hookClassMethod('com.android.okhttp.Request$Builder','addHeader',['java.lang.String','java.lang.String']);
+  hookClassMethod('com.android.okhttp.Request$Builder','header',['java.lang.String','java.lang.String']);
+});
diff --git a/scripts/hook_dump_okhttp3_methods.js b/scripts/hook_dump_okhttp3_methods.js
new file mode 100644
index 00000000..253e63f8
--- /dev/null
+++ b/scripts/hook_dump_okhttp3_methods.js
@@ -0,0 +1,18 @@
+Java.perform(function () {
+  var prefix = 'okhttp3.';
+  console.log('[dump] listing methods under ' + prefix);
+  Java.enumerateLoadedClasses({
+    onMatch: function (c) {
+      try {
+        if (c.indexOf(prefix) === 0) {
+          var Cls = Java.use(c);
+          var methods = Cls.class.getDeclaredMethods();
+          for (var i = 0; i < methods.length; i++) {
+            console.log(c + '::' + methods[i].toString());
+          }
+        }
+      } catch (e) {}
+    },
+    onComplete: function () { console.log('[dump] done'); }
+  });
+});
diff --git a/scripts/hook_list_okhttp.js b/scripts/hook_list_okhttp.js
new file mode 100644
index 00000000..a0e1e1eb
--- /dev/null
