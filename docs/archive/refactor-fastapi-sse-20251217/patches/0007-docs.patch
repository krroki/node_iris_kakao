diff --git a/docs/HANDOVER.md b/docs/HANDOVER.md
new file mode 100644
index 00000000..d85da562
--- /dev/null
+++ b/docs/HANDOVER.md
@@ -0,0 +1,15 @@
+## 멘션 토큰 캡처 실패 기록 (2025-11-24)
+
+- 현상: talk-api `dispatch`가 401(Unauthorized)로 거부되어 멘션이 텍스트로만 전송됨.
+- 환경: IRIS/봇/포트프록시 정상(5050/8510), SAFE_MODE=false, ALLOWED_ROOM_IDS=18462226881291012. talk-api base=https://talk-api.naijun.dev.
+- 시도 내역:
+  - frida-server(root, x86_64) 실행 후 KakaoTalk 프로세스에 여러 훅 적용(`hook_capture_auth_*`, wide/okhttp3 finder 등) → Authorization 로그 미발생.
+  - tcpdump 443 포트 캡처(`talkapi.pcap`) → Authorization 헤더 0건.
+  - okhttp3 클래스 메서드 덤프 시도 → 스크립트 로드시 프로세스 종료/timeout.
+- 추정 원인: 최신 KakaoTalk이 커스텀/난독화된 HTTP 스택을 사용하거나 Authorization을 네이티브 계층에서 세팅, 표준 okhttp/URLConnection 계층에서 헤더가 노출되지 않음. 또한 talk-api 토큰 자체가 만료 상태.
+- 결론: 단기적으로 멘션 포기(text-only fallback). 추후 재시도 시 옵션
+  1) KakaoTalk 구버전(APKMirror 등) 설치 후 표준 okhttp 훅으로 토큰 캡처.
+  2) talk-api 토큰을 별도 경로로 확보해 runtime에 주입.
+  3) 네이티브 계층/커스텀 클라이언트에 대한 심층 후킹(충돌/시간 부담 큼).
+- 참고 파일(커밋 대상): `scripts/hook_capture_auth_wide.js`, `hook_capture_auth_okhttp3_finder.js`, `hook_capture_auth_builder.js`, `hook_capture_auth_simple.js`
+- 커밋 제외: `talkapi.pcap`(민감/분석용)
diff --git a/scripts/capture_talkapi.ps1 b/scripts/capture_talkapi.ps1
new file mode 100644
index 00000000..70a88148
--- /dev/null
+++ b/scripts/capture_talkapi.ps1
@@ -0,0 +1,103 @@
+﻿param(
+  [string]$Serial = '172.24.194.82:5555',
+  [int]$AttachRetries = 6,
+  [int]$DriveRetries = 8,
+  [int]$TimeoutSec = 7,
+  [string]$FridaHost = '127.0.0.1:27042',
+  [string]$BaseUrl = 'https://talk-api.naijun.dev'
+)
+$ErrorActionPreference = 'Stop'
+function New-TempOut { [IO.Path]::GetTempFileName() }
+function Exec {
+  param([string]$Exe, [string]$Args = "", [int]$T=$TimeoutSec)
+  $o = New-TempOut; $e = New-TempOut
+  if ([string]::IsNullOrWhiteSpace($Args)) {
+    $p = Start-Process -FilePath $Exe -PassThru -NoNewWindow -RedirectStandardOutput $o -RedirectStandardError $e
+  } else {
+    $p = Start-Process -FilePath $Exe -ArgumentList $Args -PassThru -NoNewWindow -RedirectStandardOutput $o -RedirectStandardError $e
+  }
+  if (-not $p.WaitForExit($T*1000)) { try { $p.Kill() } catch {}; return [pscustomobject]@{ Code=124; Out=(Get-Content $o -Raw -EA SilentlyContinue); Err=(Get-Content $e -Raw -EA SilentlyContinue) } }
+  return [pscustomobject]@{ Code=$p.ExitCode; Out=(Get-Content $o -Raw -EA SilentlyContinue); Err=(Get-Content $e -Raw -EA SilentlyContinue) }
+}
+function Adb { param([string]$A) Exec 'adb' $A }
+function Ensure-Device {
+  $s = Adb "-s $Serial get-state"; if ($s.Code -ne 0 -or -not $s.Out.Trim().Equals('device')) { throw "adb device not ready: $($s.Out) $($s.Err)" }
+}
+function Ensure-FridaServer {
+  $chk = Adb "-s $Serial shell su 0 pidof frida-server"
+  if ($chk.Code -ne 0 -or [string]::IsNullOrWhiteSpace($chk.Out)) {
+    [void](Adb "-s $Serial shell su 0 nohup /data/local/tmp/frida-server -l 0.0.0.0:27042 >/sdcard/frida_usb.log 2>&1 &")
+  }
+}
+function Ensure-Forward {
+  [void](Adb "-s $Serial forward --remove tcp:27042")
+  $f = Adb "-s $Serial forward tcp:27042 tcp:27042"; if ($f.Code -ne 0) { throw "forward failed: $($f.Out) $($f.Err)" }
+}
+function Test-Frida {
+  $ps = Exec "$env:APPDATA\Python\Python313\Scripts\frida-ps.exe" "-H $FridaHost"
+  return ($ps.Code -eq 0 -and $ps.Out)
+}
+function Get-KakaoProcId {
+  $r = Adb "-s $Serial shell pidof com.kakao.talk"; return ($r.Out | Out-String).Trim()
+}
+function Ensure-KakaoRunning {
+  $k = Get-KakaoProcId; if ([string]::IsNullOrWhiteSpace($k)) { [void](Adb "-s $Serial shell am start -n com.kakao.talk/.activity.SplashActivity"); Start-Sleep -Milliseconds 800; $k = Get-KakaoProcId }
+  return $k
+}
+function Attach-FridaByName {
+  param([string]$Name='KakaoTalk')
+  $log = "$env:PUBLIC\frida_auth.log"; $err = "$env:PUBLIC\frida_auth.err"
+  Remove-Item $log,$err -EA SilentlyContinue
+  $p = Start-Process -FilePath "$env:APPDATA\Python\Python313\Scripts\frida.exe" -ArgumentList '-H', $FridaHost, '-n', $Name, '-l', 'scripts/hook_capture_auth.js' -RedirectStandardOutput $log -RedirectStandardError $err -PassThru -NoNewWindow
+  Start-Sleep -Milliseconds 1500
+  return -not $p.HasExited
+}
+function Drive-UI {
+  param([int]$Loops=6)
+  for($i=0;$i -lt $Loops;$i++){
+    [void](Adb "-s $Serial shell input tap 660 1180"); Start-Sleep -Milliseconds 300
+    [void](Adb "-s $Serial shell input tap 660 120");  Start-Sleep -Milliseconds 300
+    [void](Adb "-s $Serial shell input swipe 360 1000 360 200 500"); Start-Sleep -Milliseconds 300
+    [void](Adb "-s $Serial shell input tap 220 850");  Start-Sleep -Milliseconds 300
+    [void](Adb "-s $Serial shell input swipe 360 1000 360 200 600"); Start-Sleep -Milliseconds 300
+    [void](Adb "-s $Serial shell input tap 300 600");  Start-Sleep -Milliseconds 300
+  }
+}
+function Try-ExtractHeader {
+  $t = Adb "-s $Serial shell 'tail -n 1 /sdcard/talkapi_auth.log'"; $line = ($t.Out | Out-String).Trim();
+  if ($line -match 'Authorization: .*') { return ($line -replace '.*Authorization: ','Authorization: ') }
+  return ''
+}
+function Apply-Runtime {
+  param([string]$Header)
+  $body = @{ talkApi = @{ enabled = $true; baseUrl = $BaseUrl; authHeader = $Header } } | ConvertTo-Json -Depth 5
+  try { Invoke-RestMethod -Uri 'http://127.0.0.1:8600/runtime' -Method Post -ContentType 'application/json' -Body $body -TimeoutSec 5 | Out-Null } catch {}
+  try { return Invoke-RestMethod -Uri 'http://127.0.0.1:8600/talkapi/health' -TimeoutSec 5 } catch { return $null }
+}
+Write-Host '[1/5] Ensure device'; Ensure-Device
+Write-Host '[2/5] Ensure frida-server'; Ensure-FridaServer
+Write-Host '[3/5] Ensure forward'; Ensure-Forward
+Write-Host '[4/5] Test frida connectivity'; if (-not (Test-Frida)) { throw 'frida connectivity failed' }
+$attached=$false
+for($i=1;$i -le $AttachRetries;$i++){
+  $kp = Ensure-KakaoRunning
+  if ([string]::IsNullOrWhiteSpace($kp)) { Write-Host '[warn] KakaoTalk not running'; continue }
+  Write-Host "[attach] try $i/$AttachRetries (name)"
+  if (Attach-FridaByName) { $attached=$true; break }
+  Start-Sleep -Milliseconds 500
+}
+if (-not $attached) { throw 'frida attach failed' }
+Write-Host '[5/5] Drive UI to trigger traffic'
+Drive-UI -Loops $DriveRetries
+$header=''
+for($j=0;$j -lt 15;$j++){
+  $header = Try-ExtractHeader
+  if (-not [string]::IsNullOrWhiteSpace($header)) { break }
+  Start-Sleep -Milliseconds 500
+}
+if ([string]::IsNullOrWhiteSpace($header)) { Write-Host '[result] No Authorization header captured yet.'; exit 2 }
+Write-Host ("[result] captured: {0}" -f $header)
+Set-Content -Path "$env:TEMP\talkapi_auth_header.txt" -Value $header -Encoding UTF8
+$health = Apply-Runtime -Header $header
+if ($health -ne $null) { Write-Host '[result] /runtime updated and /talkapi/health responded:'; $health | ConvertTo-Json -Depth 5 } else { Write-Host '[result] Applied header, but health check not reachable.' }
+
diff --git a/scripts/hook_capture_auth_builder.js b/scripts/hook_capture_auth_builder.js
new file mode 100644
index 00000000..7bba05fa
--- /dev/null
+++ b/scripts/hook_capture_auth_builder.js
@@ -0,0 +1,28 @@
+Java.perform(function () {
+  function log(line) {
+    try { console.log(line); } catch (e) {}
+    try {
+      var FW = Java.use('java.io.FileWriter');
+      var BW = Java.use('java.io.BufferedWriter');
+      var fw = FW.$new('/sdcard/talkapi_auth.log', true);
+      var bw = BW.$new(fw);
+      bw.write(line + '\n'); bw.flush(); bw.close(); fw.close();
+    } catch (e) {}
+  }
+  function hookBuilder(pkg) {
+    try {
+      var Builder = Java.use(pkg + '.Request$Builder');
+      Builder.addHeader.overload('java.lang.String','java.lang.String').implementation = function(n,v){
+        try { if(n && n.toString().toLowerCase()==='authorization' && v){ log('[AUTH][addHeader]['+pkg+'] '+v); } } catch(e){}
+        return this.addHeader(n,v);
+      };
+      Builder.header.overload('java.lang.String','java.lang.String').implementation = function(n,v){
+        try { if(n && n.toString().toLowerCase()==='authorization' && v){ log('[AUTH][header]['+pkg+'] '+v); } } catch(e){}
+        return this.header(n,v);
+      };
+      log('[hook] '+pkg+'.Request$Builder installed');
+    } catch(e) { log('[hook][skip] '+pkg+'.Request$Builder: '+e); }
+  }
+  hookBuilder('okhttp3');
+  hookBuilder('com.squareup.okhttp');
+});
diff --git a/scripts/hook_capture_auth_okhttp3.js b/scripts/hook_capture_auth_okhttp3.js
new file mode 100644
index 00000000..51189d9f
--- /dev/null
+++ b/scripts/hook_capture_auth_okhttp3.js
@@ -0,0 +1,34 @@
+Java.perform(function () {
+  function log(line) {
+    try { console.log(line); } catch (e) {}
+    try {
+      var FW = Java.use('java.io.FileWriter');
+      var BW = Java.use('java.io.BufferedWriter');
+      var fw = FW.$new('/sdcard/talkapi_auth.log', true);
+      var bw = BW.$new(fw);
+      bw.write(line + '\n'); bw.flush(); bw.close(); fw.close();
+    } catch (e) {}
+  }
+
+  try {
+    var Builder = Java.use('okhttp3.Request$a'); // Builder class (obfuscated 'a')
+    Builder.header.overload('java.lang.String','java.lang.String').implementation = function(n,v){
+      try { if(n && n.toString().toLowerCase()==='authorization' && v){ log('[AUTH][header] '+v); } } catch(e){}
+      return this.header(n,v);
+    };
+    Builder.addHeader.overload('java.lang.String','java.lang.String').implementation = function(n,v){
+      try { if(n && n.toString().toLowerCase()==='authorization' && v){ log('[AUTH][addHeader] '+v); } } catch(e){}
+      return this.addHeader(n,v);
+    };
+    log('[hook] okhttp3.Request$a installed');
+  } catch(e) { log('[hook][skip] okhttp3.Request$a: '+e); }
+
+  // Also hook okhttp3.OkHttpClient$Builder interceptors to see additions (debug)
+  try {
+    var CBuilder = Java.use('okhttp3.OkHttpClient$Builder');
+    CBuilder.addInterceptor.overload('okhttp3.Interceptor').implementation = function(i){
+      try { log('[hook] addInterceptor '+i); } catch(e){}
+      return this.addInterceptor(i);
+    };
+  } catch(e){}
+});
diff --git a/scripts/hook_capture_auth_okhttp3_finder.js b/scripts/hook_capture_auth_okhttp3_finder.js
new file mode 100644
index 00000000..c5b7095b
--- /dev/null
+++ b/scripts/hook_capture_auth_okhttp3_finder.js
@@ -0,0 +1,53 @@
+Java.perform(function () {
+  function log(line) {
+    try { console.log(line); } catch (e) {}
+    try {
+      var FW = Java.use('java.io.FileWriter');
+      var BW = Java.use('java.io.BufferedWriter');
+      var fw = FW.$new('/sdcard/talkapi_auth.log', true);
+      var bw = BW.$new(fw);
+      bw.write(line + '\n'); bw.flush(); bw.close(); fw.close();
+    } catch (e) {}
+  }
+
+  var candidates = [
+    'okhttp3.Request$Builder',
+    'okhttp3.Request$a',
+    'com.android.okhttp.Request$Builder',
+    'com.squareup.okhttp.Request$Builder',
+    'com.android.okhttp.Headers$Builder'
+  ];
+
+  candidates.forEach(function (cls) {
+    try {
+      var B = Java.use(cls);
+      log('[hook] installing on ' + cls);
+      if (B.header) {
+        var o = B.header.overload('java.lang.String','java.lang.String');
+        if (o) {
+          o.implementation = function(n,v){
+            try { if(n && n.toString().toLowerCase()==='authorization' && v){ log('[AUTH]['+cls+'][header] '+v); } } catch(e){}
+            return o.call(this,n,v);
+          };
+        }
+      }
+      if (B.addHeader) {
+        var o2 = B.addHeader.overload('java.lang.String','java.lang.String');
+        if (o2) {
+          o2.implementation = function(n,v){
+            try { if(n && n.toString().toLowerCase()==='authorization' && v){ log('[AUTH]['+cls+'][addHeader] '+v); } } catch(e){}
+            return o2.call(this,n,v);
+          };
+        }
+      }
+    } catch (e) {
+      log('[hook][skip] ' + cls + ': ' + e);
+    }
+  });
+
+  // Log when Request is built (to see headers)
+  try {
+    var Req = Java.use('okhttp3.Request');
+    var orig = Req.build.overload(); // may not exist
+  } catch (e) {}
+});
diff --git a/scripts/hook_capture_auth_simple.js b/scripts/hook_capture_auth_simple.js
