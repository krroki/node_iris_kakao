+let conect = "\nhttps://www.youtube.com/watch?";
+let allsee="\u200b".repeat(500);
+
+function response(room, msg, sender, isGroupChat, replier, imageDB, packageName) {
+  if(msg.indexOf("!검색")==0)
+{
+    
+    let serch = msg.substring(4);
+    let html = Utils.getWebText("https://www.youtube.com/results?search_query="+serch);
+    let ans = "";
+    for(fst = 1; fst<=4; ++fst) {
+      ans = ans+"\n"+html.split('"title":{"runs":[{"text":"')[fst].substr(0,html.split('"title":{"runs":[{"text":"')[fst].indexOf(('"}],')));
+      ans = ans+conect+html.split("watch?")[fst].substring(0,html.split("watch?")[fst].indexOf('"'))+"\n";
+    }
+    replier.reply(serch+"의 검색결과입니다"+allsee+"\n\n"+ans);
+
+  }
+}
