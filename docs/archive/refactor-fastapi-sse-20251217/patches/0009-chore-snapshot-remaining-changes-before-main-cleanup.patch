+function response(room, msg, sender, isGroupChat, replier, ImageDB) {
+
+
+if(msg.indexOf("!봇 ")!=-1) {
+var random = msg.substring(4)
+var randoms = random.split("vs")
+var randomnum = Math.floor(Math.random()*2)
+if(randomnum == 0) {
+replier.reply(randoms[0])
+}else{
+replier.reply(randoms[1])
+}
+}
