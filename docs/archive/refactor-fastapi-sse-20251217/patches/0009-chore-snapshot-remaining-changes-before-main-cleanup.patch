+function getLastFile(path) {
+
+  var listFiles = new java.io.File(path).listFiles();
+
+  var listLastFiles = listFiles.sort(function (a, b) {
+
+    return b.lastModified() - a.lastModified();
+
+  });
+
+  return listLastFiles[0].toString();
+
+}
+
+​
+
+function getLastPictureFilePath(path) {
+
+  try {
+
+    var listFiles = new java.io.File(getLastFile(path)).listFiles();
+
+    var listLastFiles = listFiles.sort(function (a, b) {
+
+      return b.lastModified() - a.lastModified();
+
+    });
+
+    for (let i = 0; i < listLastFiles.length; i++) { 
+
+      var file = new java.io.File(listLastFiles[i].toString());
+
+      var fileList = file.listFiles();
+
+      if (fileList.length == 0) {
+
+        continue;
+
+      } else {
+
+        return getLastFile(file.getPath());
+
+      }
+
+    }
+
+  } catch(e) {
+
+    return null;
+
+  }
+
+}
