+function shoe(a){
+ var xs = [];
+ var ys = [];
+ var r = 0;
+ var l = 0;
+ for(var i = 0; i<a.length; i++){
+  xs.push(a[i][0]);
+  ys.push(a[i][1]);
+ }
+ xs.push(a[0][0]);
+ ys.push(a[0][1]);
+ for(var j = 0; j<xs.length-1; j++){
+  l += xs[j] * ys[j+1];
+  r += xs[j+1] * ys[j];
+ }
