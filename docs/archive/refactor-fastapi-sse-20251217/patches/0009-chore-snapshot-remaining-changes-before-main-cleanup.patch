+function Bar(Max, Num) {
+
+  var per = (Num / Max) * 100;
+
+  var R = 0;
+
+  var O = "░".repeat(10).split("");
+
+  var perN = Number(per);
+
+  for (var i = 0; i < per; i = i + 10) {
+
+    R++;
+
+    perN = perN - 10;
+
+  }
+
+  var Ro = Number(R);
+
+  for (; R >= 1; R = R - 1) {
+
+    O[R - 1] = "█";
+
+  }
+
+  if (perN < 0) {
+
+    if (perN <= -10 + 1.25) {
+
+      O[Ro - 1] = "▏";
+
+    } else if (perN <= -10 + 2.5) {
+
+      O[Ro - 1] = "▎";
+
+    } else if (perN <= -10 + 3.75) {
+
+      O[Ro - 1] = "▍";
+
+    } else if (perN <= -10 + 5) {
+
+      O[Ro - 1] = "▌";
+
+    } else if (perN <= -10 + 6.25) {
+
+      O[Ro - 1] = "▋";
+
+    } else if (perN <= -10 + 7.5) {
+
+      O[Ro - 1] = "▊";
+
+    } else if (perN <= -10 + 8.75) {
+
+      O[Ro - 1] = "▉";
+
+    }
+
+  }
+
+  if (per.toFixed(1) == "NaN") {
+
+    return "[" + O.join("") + "]0.000%";
+
+  } else if (O.length <= 10) {
+
+    return "[" + O.join("") + "]" + per.toFixed(1) + "%";
+
+  } else {
+
+    return "[" + O.join("").substr(0, 10) + "}" + per.toFixed(1) + "%";
+
+  }
+
+}
