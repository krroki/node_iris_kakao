+const parseTime = (time) => {
+
+  let num = time.split('');
+
+  const unit = num.pop();
+
+  num = isNaN(Number(num.join(''))) ? 0 : Number(num.join(''));
+
+  
+
+  let msec = 0;
+
+  
+
+  switch (unit) {
+
+    case '분':
+
+      msec = num * 60 * 1000;
+
+      break;
+
+    case '초':
+
+      msec = num * 1000;
+
+      break;
+
+  }
+
+  
+
+  return msec;
+
+}
+
