+let Music = {};
+
+​
+
+function playMP3 (name, repeat) {
+
+    let path = "sdcard/Download/" + name;
+
+    repeat = repeat | 1;
+
+    let mp = null;
+
+    for (let i = 0; i < repeat; i++) {
+
+        mp = new MediaPlayer();
+
+        mp.setDataSource(path);
+
+        mp.setLooping(true);
+
+        mp.prepare();
+
+        dura = mp.getDuration();
+
+        mp.start();
+
+        Music[name] = mp;
+
+        java.lang.Thread.sleep(dura);
+
+        mp.stop();
+
+    }
+
+    Music[name] = null;
+
+    return name;
+
+}
+
+​
+
+function stopMP3 (name) {
+
+    Music[name].stop();
+
+    Music[name] = null;
+
+}
