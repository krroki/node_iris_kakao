+table: function(data){
+let res = "|| index || ";
+let keys = new Array();
+for(i=0; i<data.length; i++){
+obkeys = Object.getOwnPropertyNames(data[i]);
+for(j=0; j<obkeys.length; j++){
+if(keys.indexOf(obkeys[j]) == -1){
+keys.push(obkeys[j]);
+}
+}
+}
+for(i=0; i<keys.length; i++){
+res += keys[i] + " || ";
+}
+for(i=0; i<data.length; i++){
+obres = "\n|| " + i + " || ";
+for(j=0; j<keys.length; j++){
+if(data[i].hasOwnProperty(keys[j])){
+obres += data[i][keys[j]] + " || ";
+}
+if(!data[i].hasOwnProperty(keys[j])){
+obres += "_ || ";
+}
+}
+res += obres;
+}
+return res;
+}
