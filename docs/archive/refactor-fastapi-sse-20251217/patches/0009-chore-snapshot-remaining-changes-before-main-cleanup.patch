+Array.prototype.mix=function(){
+
+var arr=this;
+
+var newArr=[];
+
+while(0<arr.length){
+
+var n=Math.floor(Math.random()*arr.length);
+
+newArr.push(arr[n]);
+
+arr.splice(n,1);
+
+}
+
+return newArr;
+
+}
