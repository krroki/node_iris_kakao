+function check(str1, str2) {
+
+  result = 0;
+
+  str1 = str1.normalize("NFKD").split("");
+
+  str2 = str2.normalize("NFKD").split("");
+
+  for (i = 0; i < str1.length; i++) {
+
+    if (str1[i] != str2[i]) {
+
+      result += 1;
+
+    }
+
+  }
+
+  return result;
+
+}
