+
+웹툰 파싱 해봤는데 피드백 해주세요
+
+const js="⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼";
+const Jsoup=org.jsouo.Jsoup;
+//대충 리스폰스
+if(msg.startsWith("/웹툰 ")){
+try{
+msg=msg.slice(4);
+let sc = "https://m.comic.naver.com/search/result.nhn?keyword="+msg;
+let a = Jsoup.connect(sc).get()
+.select('div[class="toon_info"]')
+.get(0);
+let Works = a.select('span[class="toon_name"]').text()
+let Writer=a.select('p[class="sub_info"]').text()
+let Rating=a.select('span[class="txt_score"]').text()
+let State=a.select('span[class="blind"]').text()
+State=State==""?"연재중":State;
+replier.reply(["• "+msg+" 웹툰 검색 결과 입니다",js,"작품 : "+Works,"작가 : "+Writer,"평점 : "+Rating,"상태 : "+State].join("\n"));
+}catch(e){replier.reply("검색 결과가 없습니다");}
+}
