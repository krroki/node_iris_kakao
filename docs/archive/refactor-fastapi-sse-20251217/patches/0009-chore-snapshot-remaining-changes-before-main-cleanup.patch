+function leastValue(arr) {
+if(!Array.isArray(arr)) arr = Object.keys(arguments).map(s => arguments[s]);
+//arguments는 배열이 아닌 유사배열이라서 배열로 바꿉니다.
+var data = {};
+arr.forEach(s => {
+if(s in data) data[s]++;
+else data[s] = 1;
+});
+if(Object.keys(data).every((s, i, a) => data[s] == data[a[0]]) {
+return [];
+}
+data = Object.keys(data).map(s => [s, data[s]]);
+var least = data.sort((a, b) => b[1] - a[1])[0][1];
+return data.filter(s => s[1] == least).map(s => s[0]);
+}
