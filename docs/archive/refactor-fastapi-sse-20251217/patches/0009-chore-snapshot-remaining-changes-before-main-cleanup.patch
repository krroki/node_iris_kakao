+ function remove(path) {
+ 
+     let folder = new java.io.File(path);
+     try {
+ if(folder.exists()){
+                let folderlist = folder.listFiles(); //파일리스트 얻어오기
+ 
+ for (let i = 0; i < folderlist.length; i++) {
+     if(folderlist[i].isFile()) {
+ folderlist[i].delete();
+     }else {
+ remove(folderlist[i].getPath()); //재귀함수호출
+     }
+  }
+  folder.delete(); //폴더 삭제
+  return "삭제완료!"
+        } else {
