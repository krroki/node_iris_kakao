+New-Task -Name 'IRIS_KB_Manualize' -Action "$ps -ExecutionPolicy Bypass -File `"$runner`" -Task manual"  -Schedule 'HOURLY'
+
+Write-Host 'Scheduled tasks created. You can review in Task Scheduler.' -ForegroundColor Green
