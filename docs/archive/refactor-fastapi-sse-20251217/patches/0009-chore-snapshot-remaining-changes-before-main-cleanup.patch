+for(var i=0 ; i<list.length ; i++){
+if(num%list[i]==0){
+var a=0;
+while(num%list[i]==0){
+num=num/list[i];
+a++;
+}
+if(a>1){
+log.push(list[i]+"^"+a);
+}else{
+log.push(list[i]);
+}
+}
+}
+if(num!=1) log.push(num);
+replier.reply(log.join("×"));
+}else{
+replier.reply(num);
+}
+}catch(e){
+replier.reply("/소인수분해 (숫자) 형식으로 입력해주세요");
+}
