+var timeout = 0;
+
+
+function response(room, msg, sender, isGroupChat, replier, ImageDB, packageName, threadId) {
+ if (msg == "제한시간") {
+ timeout ++;
+ new java.lang.Thread({
+ run : function(){
+ var out = timeout;
+ java.lang.Thread.sleep(20000);
+ if(out == timeout) {
+ replier.reply("20초가 지났습니다.");
+ timeout = 0;
+ out = null;
+ }
+ }
+ }).start();
+ }
+}
+
+
+제한시간 을 입력 후 20초 내에 다시 입력하지 않으면 20초가 지났다는 알림이 옵니다.
+if문을 적당히 수정할 경우 많은 응용이 가능하겠군요.
