+if(msg.indexOf("@로또") ==0)
+{
+var lotto = new Array(6);
+var a = 0;
+var o = true;
+while (a < 6) {
+    var n = 0;
+    n = Math.floor(Math.random()*45 + 1);
+    for (var i = 0; i < a; i++) {
+        if(lotto[i] == n) {
+            o = false;
+        }
+    }
+    if(o) {
+        lotto[a] = n;
+        a++
+    }
+    o = true;
+}
