+var a=org.jsoup.Jsoup.connect("https://m.search.naver.com/search.naver?where=m_kin&sm=mtb_jum&query="+encodeURIComponent(que)).get().select('div[class="api_txt_lines dsc_txt"]');
+
+var result=[];
+
+var Size=0;
+
+try{
+
+a.get(100000000);
+
+}catch(e){
+
+Size=Number(e.toString().split("Size: ")[1]);
+
+}
+
+for(var i=0;i<Size/2;i+=2){
+
