+
+function response(room,msg,sender,isGroupChat,replier,ImageDB,packageName){
+    if(!유저[sender]){유저[sender]={"msg":" ","wait":false};}
+    if(유저[sender].wait){유저[sender].msg = msg; return;}
+    if(msg=="입력"){
+        replier.reply("아무 말이나 입력하세요.");
+        var answer = scanf(sender);
+        replier.reply("『" + answer + "』");
+    }
+}
+
+
+function scanf(sender){
+    유저[sender].wait=true;
+    유저[sender].msg = " ";
+    while(유저[sender].msg == " "){}
+    유저[sender].wait=false;
+    return 유저[sender].msg;
+}
