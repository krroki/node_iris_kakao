+function repeat(degree, func) {
+    if (typeof degree !== 'number') {
+        throw new TypeError('Invalid degree type. Please set it to a number type.');
+    } else if (degree < 1 || degree > 100) {
+        throw new RangeError('The value is out of range. Please set it to a number between 1 and 100.');
+    } else if (typeof func !== 'function') {
+        throw new TypeError('Invalid func type. Please set it to a function type.');
+    } else {
+        for (let i = 0; i < degree; i++) func();
+    }
+}
+
+/* 사용법 : repeat(횟수, 함수);
+ * 예시 : repeat(3, () => Api.replyRoom(room, '안녕하세요'));
