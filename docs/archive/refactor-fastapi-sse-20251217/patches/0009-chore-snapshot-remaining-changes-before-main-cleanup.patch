+const scriptName = "채팅읽기";
+
+var Chat = {};
+
+var ChatNum = 0;
+
+
+function response(room, msg, sender, isGroupChat, replier, imageDB, packageName) {
+
+  replier.reply(ChatNum);
+
+  if(Chat[room]== undefined){
+
+    Chat[room] = 1;
+
+  }
+
+  else{
+
+    Chat[room]++;
+
+  }
+
+  
+
+  ChatNum++;
+
+  
+
+  if(ChatNum>=250){
+
+    if(Chat[room]<30) return;
+
+    replier.reply("[AI] 자동읽기\n\n현재 방에 쌓인 메세지 : "+Chat[room]+"\n전체 방에 쌓인 메세지 : "+ChatNum+"\n\n* 봇은 메세지가 300개 이상 쌓이면 오류");
+
+    ChatNum = ChatNum-Chat[room];
+
+    Chat[room] = 0;
+
+    }
+
+  if(msg=="/Read"){ 
+
+    replier.reply("[AI] 자동읽기\n\n현재 방에 쌓인 메세지 : "+Chat[room]+"\n전체 방에 쌓인 메세지 : "+ChatNum+"\n\n* 봇은 메세지가 300개 이상 쌓이면 오류");
+
+  }
+
+}
