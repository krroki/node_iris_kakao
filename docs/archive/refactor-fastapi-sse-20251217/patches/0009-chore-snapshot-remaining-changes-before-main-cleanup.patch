+function New-Task {
+  param(
+    [string]$Name,
+    [string]$Action,
+    [string]$Schedule,
+    [int]$Minutes = 15
+  )
+  $cmd = "schtasks /Create /TN `"$Name`" /TR `"$Action`" /SC $Schedule"
