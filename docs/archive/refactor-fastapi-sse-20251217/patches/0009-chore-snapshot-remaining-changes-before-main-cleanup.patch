+function makeBar(count, max, barLength) {
+    const BAR = ['', '▏', '▎', '▍', '▌', '▋', '▊', '▉', '█'];
+
+
+    let length = (barLength * count / max),
+        dec = length % 1,
+        int = length - dec,
+        result = (BAR[8].repeat(int) + BAR[Math.round(dec * 8)]);
+
+
+    return (result + ' '.repeat(barLength - result.length));
+}
+
+
+
