+function getWeather() {
+
+  var split = org.jsoup.Jsoup.connect("https://m.search.naver.com/search.naver?query=날씨").get().toString().split("전국날씨</strong>")[1].split("특보")[0].replace(/도씨/g, "℃").replace(/(<([^>]+)>)/g, "").trim().split(" ");
+
+  var trim = split[0].trim();
+
+  for (i = 1; i < split.length; i++) {
+
+    if (!split[i].trim().equals("단위 ℃")) {
+
+      trim += "\n" + split[i].trim();
+
+    }
+
+  }
+
+  return trim.replace(/\n\n/g, "\n").replace(/\n\n\n/g, "").replace(/비\n끝남/g, "비 끝남");
+
+}
