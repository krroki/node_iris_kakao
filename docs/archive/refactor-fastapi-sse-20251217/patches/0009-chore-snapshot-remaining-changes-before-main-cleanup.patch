+Function.prototype.method = function (name, func) {
+this.prototype[name] || (this.prototype[name] = func);
+};
+
+function File(path) {
+this.path = path;
+}
+
+File.method("save", function (value) {
+let a = new java.io.File(this.path),
+b = new java.io.FileOutputStream(a),
+c = new java.lang.String(value);
+
+if (!a.exists()) {
+a.getParentFile().mkdirs();
+a.createNewFile();
+}
+
+b.write(c.getBytes());
+b.close();
+});
+
+File.method("read", function () {
+let a = new java.io.File(this.path);
+
+if (!a.exists()) return null;
+
+let b = new java.io.FileInputStream(a),
+c = new java.io.InputStreamReader(b),
+d = new java.io.BufferedReader(c),
+e = d.readLine(),
+f = "";
+
+while ((f = d.readLine()) !== null) e += ("\n" + f);
+
+b.close();
+c.close();
+d.close();
+
+return e.toString();
+});
+
