+let Music = {};
+
+​
+
+function playMP3 (name, repeat, speed) {
+
+    let path = "sdcard/Download/" + name;
+
+    if (repeat === undefined) repeat = 1;
+
+    if (speed === undefined) speed = 1;
+
+    let mp = null;
+
+    for (let i = 0; i < repeat; i++) {
+
+        let mp = new MediaPlayer();
+
+        mp.setDataSource(path); mp.setPlaybackParams(mp.getPlaybackParams().setSpeed(parseFloat(speed)));
+
+        mp.setLooping(true);
+
+        mp.prepare();
+
+        let dura = mp.getDuration();
+
+        mp.start();
+
+        Music[name] = mp;
+
+        java.lang.Thread.sleep(dura);
+
+        mp.stop();
+
+    }
+
+    Music[name] = null;
+
+    return name;
+
+}
+
+​
+
+function stopMP3 (name) {
+
+    Music[name].stop();
+
+    Music[name] = null;
+
+}
