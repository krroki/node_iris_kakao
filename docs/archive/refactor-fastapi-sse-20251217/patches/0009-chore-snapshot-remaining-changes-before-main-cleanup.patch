+const File = java.io.File;
+
+function makeFileTree(directory) {
+    let result = "";
+
+    function dfs(dir, depth) {
+        let file = new File(dir);
+        result += "    ".repeat(depth) + file.getName() + "\n";
+
+        if (file.isDirectory()) {
+            let files = file.listFiles();
+
+            for (let i = 0; i < files.length; i ++) {
+                dfs(new File(files[i]), depth + 1);
+            }
+        }
+    }
+    
+    dfs(directory, 0);
+
+    return result;
+}
