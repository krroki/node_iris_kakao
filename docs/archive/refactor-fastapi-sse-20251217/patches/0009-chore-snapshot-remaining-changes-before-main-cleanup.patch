+//양쪽
+function All_engch(str) {
+var f = []; if (/\W /g.test(str)) return "[Error: The String Is Not English]";
+for(var a=0; a<str.length; a++) {if(/[a-z]/g.test(str[a])) f.push(str[a].toUpperCase()); else f.push(str[a].toLowerCase()); }
+return f.join("");}
+
+//소문자 ➺ 대문자
+function Big_engch(str) {
+if (/\W /g.test(str)) return "[Error: This String Is Not Lowercase]";
+return str.toUpperCase(str);
+}
+
+//대문자 ➺ 소문자
+function Low_engch(str) {
+if (/\W /g.test(str)) return "[Error: This String Is Not Big Letter]";
+return str.toLowerCase(str);
+}
+
