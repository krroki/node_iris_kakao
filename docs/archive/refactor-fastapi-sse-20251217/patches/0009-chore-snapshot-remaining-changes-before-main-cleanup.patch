+소스 코드
+=>
+
+ 
+
+var mwin=0;
+var fwin=0;
+var turn=0;
+function response(room, msg, sender, isGroupChat, replier, ImageDB, packageName, threadld) {
+if(msg=="1p") {
+fwin++;
+turn++
+}
+if(msg=="2p"){
+mwin++;
+turn++
+}
+if(msg=="1p-"){
+fwin--;
+turn--;
+}
+if(msg=="2p-"){
+mwin--;
+turn--;
+}
+if(msg=="re"){
+mwin=0;
+fwin=0;
+turn=0;
+replier.reply("[승률정보가 초기화되었습니다]");
+return;
+}
+var all=fwin+mwin;
+var mwine=mwin/all*100;
+var fwine=fwin/all*100;
+mwine=Math.round(mwine);
+fwine=Math.round(fwine);
+replier.reply("["+turn+"째 턴]\n이긴 횟수 : "+fwin+"번 "+mwin+"번\n승률 : "+fwine+"% "+mwine+"%");
+}
