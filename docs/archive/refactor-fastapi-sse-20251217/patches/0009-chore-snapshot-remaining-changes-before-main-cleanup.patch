+function tree(path){
+var a=[[java.io.File(path),0]];
+var ans=[];
+while(a.length){
+[f,d]=a.pop();
+ans.push(" ".repeat(d*4)+">"+f.name);
+try{
+a=a.concat(f.listFiles().map(b=>[b,d+1]));
+}catch(e){}
+}
+return ans.join("\n");
+}
+tree("sdcard/")
+
+//반복문으로 구현
+
+
+
+function tree(path){
+return (function tmp(path){
+var ans=[">"+java.io.File(path).name];
+try{ ans=ans.concat.apply(ans,java.io.File(path).listFiles().map(a=>tmp(a).map(b=>" "+b)));
+}catch(e){}
+return ans;
+})(path).join("\n")
+}
+tree("sdcard/")
+
