+function isPrime(x){
+// 0과 1은 소수가 아니기 때문에 예외처리 해주겠습니다.
+
+if (x < 2) return false;
+
+
+
+//n이 2이상이라면 아래 코드를 실행합니다.
+
+for (i = 2; i < x-1; i++)
+
+{
+
+// 만약 x/i가 나머지가 0이라면
+
+if (x % i == 0)
+
+// 소수가 아니므로 거짓을 반환합니다.
+
+return false;
+
+}
+
+// 만약 for문이 모두 실행됐으면 소수란 뜻이므로 참을 반환합니다.
+
+return true;
+
+
+}
