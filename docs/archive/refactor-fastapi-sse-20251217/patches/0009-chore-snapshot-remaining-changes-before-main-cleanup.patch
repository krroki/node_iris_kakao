+ImgToBase64 = path => {
+imgFile = new java.io.File(path)
+bm = android.graphics.BitmapFactory.decodeFile(path)
+bOut = new java.io.ByteArrayOutputStream()
+bm.compress(android.graphics.Bitmap.CompressFormat.JPEG, 100, bOut)
+return android.util.Base64.encodeToString(bOut.toByteArray(), android.util.Base64.DEFAULT)
+}
