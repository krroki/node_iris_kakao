+이런식으로 잘 작동하고요, 코드는
+
+function response(room, msg, sender, isGroupChat, replier){
+if(room=="방"){
+if(msg.indexOf(".tri ")==0){
+var nsg = msg.substring(5);
+var a = Number(nsg.split(" ")[0]);
+var b = Number(nsg.split(" ")[1]);
+var c = Number(nsg.split(" ")[2]);
+if(a>0&&b>0&&c>0&&a+b>c&&a+c>b&&b+c>a){
+//삼각형 성립 확인
+var n = (a+b+c)/2;
+var s = Math.sqrt(n*(n-a)*(n-b)*(n-c))
+//헤론의 공식 대입
+replier.reply(s);
+//넓이 출력
+}}}}
