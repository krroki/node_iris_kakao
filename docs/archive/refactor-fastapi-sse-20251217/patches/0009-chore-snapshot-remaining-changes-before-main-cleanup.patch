+var nGame = false;
+var q = 0;
+const prePlayer = {};
+
+
+function response(room, msg, sender, isGroupChat, replier, ImageDB, packageName, threadId){
+if(msg.indexOf("숫자맞추기") == 0){
+    msg = msg.substr(6);         
+    if(msg <= 1 || msg > 10000) {
+    replier.reply("숫자의 범위는 2~10000으로 해주세요");
+    } else if(msg > 1&&msg <= 10000){
+    replier.reply ("숫자를 맞춰보세요!\n숫자는 1~" + msg + " 사이에 있어요.\n(예시 : !숫자)");
+    q = Math.floor(Math.random()*msg) + 1;
+    nGame = true;
+    }
+}  
+if(nGame == true && msg.indexOf("!") == 0){
+    if(prePlayer[room] == sender) {
+    replier.reply("연속 두번째 질문하셨어요!순서를 기다려주세요.");
+    return;
+    } prePlayer[room] = sender;
+    if(msg.split("!")[1] == q){
+    replier.reply(sender + "님이 맞추셨어요!!");
+    nGame = false;
+    prePlayer[room] = "";
+    } else if(msg.split("!")[1] > q) {
+    replier.reply(msg.split("!")[1]+" 보단 작아요");
+    } else if(msg.split("!")[1] < q) {
+    replier.reply(msg.split("!")[1]+" 보다는 크답니다~");
+    }
+}
+}
