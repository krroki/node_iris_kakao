+		result = msg; 
+		for (let i = 0; i < subCmdLen; i++) { 
+			result = result.replace((type == "prefix" ? prefix : type == "adminPrefix" ? adminPrefix : "") + cmd.split("|")[i], ""); 
+		} 
+	}else{ 
+		result = msg.replace((type == "prefix" ? prefix : type == "adminPrefix" ? adminPrefix : "") + cmd, ""); 
+	} 
+	return result.trim(); 
+} 
