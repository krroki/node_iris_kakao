+var 조1 = [];
+var 조2 = [];
+
+var 조조1 = 0;
+var 조조2 = 0;
+
+function response(room, msg, sender, isGroupChat, replier, imageDB, packageName) {
+
+var ssap = (Math.floor(Math.random()*2)+1);
+
+if(msg == "/참여"){
+if(조1.indexOf(sender)==-1){
+replier.reply("");
+}
+else
+if(msg == "/참여"){
+replier.reply("당신은 이미 1조에 참가되어있습니다\n[1조] : "+조1+"\n[2조] : "+조2);
+return;
+}
+}
+
+if(msg == "/참여"){
+if(조2.indexOf(sender)==-1){
+replier.reply("");
+}
+else
+if(msg == "/참여"){
+replier.reply("당신은 이미 2조에 참가되어있습니다\n[1조] : "+조1+"\n[2조] : "+조2);
+return;
+}
+}
+
+
+if(msg == "/참여"){
+if(ssap == 1){
+조1.push(sender);
+조조1 ++;
+replier.reply("당신은 "+ssap+"조에 참가됬습니다\n[1조] : "+조1+"\n[2조] : "+조2);
+}
+}
+
+if(msg == "/참여"){
+if(ssap == 2){
+조2.push(sender);
+조조2 ++;
+replier.reply("당신은 "+ssap+"조에 참가됬습니다\n[1조] : "+조1+"\n[2조] : "+조2);
+}
+}
+}
