+try{
+if (n <= 1) {
+return false;
+}
+if (n == 2 || n == 3) {
+return true;
+}
+if (n % 2 === 0) {
+return false;
+}
+var a = 3;
+var b = Math.sqrt(n);
+while (b >= a) {
+if (n % a == 0) {
+return false;
+}
+a = a + 2;
+}
+return true;
+}
+}catch(e){
+return NaN
