+   if(room=="답장할방이름"&&!(새해인사.indexOf(sender)!=-1)&&인사시작==true) {
+   replier.reply(sender+"님! 올해 새해복 많이 받으세요~~");
+   새해인사.push(sender);
+   }
+}
