+function divby(a,b,c){
+ var tmp="";
+ var d=a;
+ var e=b;
+ var divzero=false;
+ var divnotzero=false;
+    for(var i=0;;i++){
+        for(var j=1;;j++){
+ if(d-e*j==0&&!divnotzero){
+ tmp=j;
+ divzero=true;
+ break;
+ }else if(d-e*j<0){
+ d=Number(d-e*(j-1)+"0");
+ if(!divnotzero){
+ tmp+=j-1+".";
+ }else{
+ tmp+=j-1+"";
+ }
+ divnotzero=true;
+ break;
+ }
+ }
+ if(divzero) break;
+ if(c == undefined){
+ if(tmp.split(".")[1].length >= 16) break;
+ }else{
+ if(tmp.split(".")[1].length >= c) break;
+ }
+ }
+ return tmp;
+}
