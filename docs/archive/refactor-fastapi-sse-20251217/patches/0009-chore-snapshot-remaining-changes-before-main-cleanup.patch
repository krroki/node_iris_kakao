+function pitest(N){
+//N == 실험할 횟수
+var M = 0;
+var x;
+var y;
+
+for (var k = 0;k<=N;k++){
+x = (Math.random()*2)-1;
+y = (Math.random()*2)-1;
+//(x,y)점 임의로 생성
+
+if(Math.sqrt(x*x+y*y)<1) M+=1;
+}
+return 4*M/N;
+}
