+function getCardLink(text) {
+  try {
+    var type = "greeting_01";
+    var key = "XzAJxSOvjQFgrH0fvQYsHQAAABM";
+    var Text = java.lang.String(text).getBytes("UTF-8");
+    var padding = "padding_top=60&padding_bottom=504&padding_left=70&padding_right=70";
+    var query = "%25EC%25B9%25B4%25EB%2593%259C%2520%25EB%25A7%258C%25EB%2593%25A4%25EA%25B8%25B0";
+    var Encode_Text = android.util.Base64.encodeToString(Text, android.util.Base64.DEFAULT).replace(/=/g, "%253D");
+    var url = "https://m.search.daum.net/qsearch?w=textcon&m=greeting&viewtype=raw&output=image&mk=" + key + "&uk=" + key + "&font=BMJUA&" + padding + "&q=" + query + "&background=" + type + "&rawText=";
+    var getLink = JSON.parse(org.jsoup.Jsoup.connect(url + Encode_Text).get().text()).response;
+    var result = "https://search1.daumcdn.net/textcon/greeting/service/" + getLink;
+    return result;
+  }  catch (e) {
+    return null;
+  }
