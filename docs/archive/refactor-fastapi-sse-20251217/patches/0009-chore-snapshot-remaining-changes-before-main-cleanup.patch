+packBlank=function(str) {
+
+    var input = str;
+
+    var result = "";
+
+    for (var i = 0; i < input.split("").length; i++) {
+
+        var a = String.charCodeAt(input.split("")[i]);
+
+        var b = (a).toString(2);
+
+        result += b.toString().replace(/1/g, "\u200b").replace(/0/g, "\u200c")+"\u200a";
+
+    }
+
+    return result;
+
+}
+
+unpackBlank=function (str) {
+
+    var a = str.replace(/\u200b/g, "1").replace(/\u200c/g, "0")
+
+    var b = a.split("\u200a");
+
+    var c = [];
+
+    for (var i = 0; i < b.length; i++) { c.push(String.fromCharCode(parseInt(b[i], 2)));
+
+    }
+
+    var d = c.join("");
+
+   var e=d.replace(/\x00/g,"").replace(/\n/g,"\\n");
+
+  return e;
+
+}
