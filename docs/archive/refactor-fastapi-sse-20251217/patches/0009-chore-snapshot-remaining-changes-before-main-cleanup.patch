+
+    /**
+     * File content
+     */
+    buffer: Buffer;
+  }|ReadonlyArray<{
+    /**
+     * File name
+     */
+    name: string;
+
+    /**
+     * File type
+     */
+    mimeType: string;
+
+    /**
+     * File content
