+    // last resort: find any string with '@' sign
+    const found = findFirstStringWithAt(obj);
+    if (found) return found;
+  } catch {
+    // Fallback: extract msg=... from textual dump like: Message(id=..., msg=...)
+    const m = praw.match(/msg=(?:\"([^\"]*)\"|([^,\)]*))/);
+    if (m) {
+      return (m[1] || m[2] || '').trim();
+    }
+  }
+  return praw;
+}
+
+function findFirstStringWithAt(obj: any): string | null {
+  try {
+    if (typeof obj === 'string') {
+      return /@/.test(obj) ? obj : null;
+    }
+    if (Array.isArray(obj)) {
+      for (const v of obj) { const r = findFirstStringWithAt(v); if (r) return r; }
+    } else if (obj && typeof obj === 'object') {
+      for (const k of Object.keys(obj)) { const r = findFirstStringWithAt(obj[k]); if (r) return r; }
+    }
+  } catch {}
+  return null;
+}
