+const scriptName="맞춤법.js";
+
+importClass(org.jsoup.Jsoup)
+function response(room, msg, sender, isGroupChat, replier, ImageDB, packageName, threadId){
+msg=msg.trim()
+msgn=msg.split(" ")
+if(msgn[0]==".맞춤법"&&msgn[1]!=undefined){
+doc=Jsoup.connect("http://speller.cs.pusan.ac.kr/results").data("text1",msg.substr(5)).get()
+if(doc.select("script").size()<=2){
+replier.reply("고칠 단어가 없습니다.")
+return;
+}
+js=String(doc.select("script").get(2))
+r=JSON.parse(/data = (.*);/g.exec(js)[1])
+replier.reply("입력한 단어 "+r[0]['errInfo'][0]['orgStr']+"\n교정된 단어 "+r[0]['errInfo'][0]['candWord'])
+}
