+function response(room, msg, sender, isGroupChat, replier) {
+
+if (msg.indexOf("/원소 ") == 0) {
+
+var a = "\u200b".repeat(500);
+
+var atom = org.jsoup.Jsoup.connect("https://namu.wiki/w/"+msg.substr(4)).get().select("tbody").get(4).select("div.wiki-paragraph")
+
+var r=""
+
+for(var i=0;i<atom.size();i++){
+
+r+=atom.get(i).text()
+
+r+=(i%2==0)? "\n" : " "
+
+}
+
+r=r.split("이전")[0].trim()
+
+replier.reply(msg.substr(4)+"의 정보입니다."+a+"\n\n"+r);
+
+}
+
+}
