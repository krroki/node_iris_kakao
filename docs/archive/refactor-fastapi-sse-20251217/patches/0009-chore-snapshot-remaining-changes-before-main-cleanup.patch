+function All_engch(str) {
+var f = []; if (/\W /g.test(str)) return "[Error: The String Is Not English]";
+for(var a=0; a<str.length; a++) {if(/[a-z]/g.test(str[a])) f.push(str[a].toUpperCase()); else f.push(str[a].toLowerCase()); }
+return f.join("");}
