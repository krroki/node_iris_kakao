+function deepCopy(target){
+    let res
+    res = Object.prototype.toString.call(target).slice(8, -1) === "Object"? {} : []
+    for(let i in target)
+        res[i] = typeof target[i] === "object"? deepCopy(target[i]) : target[i]
+    return res
+}
