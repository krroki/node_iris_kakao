+randomPick = function(v){
+var result = [];
+function b(){
+var c = Math.floor(Math.random()*45)+1;
+if(result.indexOf(c)!=-1)
+return b(); else return c;
+}
+for(var a = 0; a<v; a++)
+result.push(b())
+return result.sort(function(a,b){return a-b});
+}
+
+//사용법: randomPick(뽑을 숫자 갯수)
+
+뽑을 숫자 갯수를 입력안하고 안된다고 하시면
