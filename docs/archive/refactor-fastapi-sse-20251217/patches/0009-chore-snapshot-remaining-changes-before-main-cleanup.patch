+
+if (msg[0] == "@") {
+if (isStart) {
+num = Number(msg.substr(1))
+if (!isNaN(num)) {
+if (num == randNum) {
+replier.reply("[!] 숫자를 맞추셨습니다!\n지정된 숫자는 "+randNum+" 이었습니다!")
+Reset();
+} else if (num > randNum) {
