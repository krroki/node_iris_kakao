+소스 코드
+=>
+밑에
+(중간에 
+betterSqrt = n => {
+    let sqrt = Math.sqrt(n);
+
+
+    if (sqrt == (sqrt | 0))
+        return sqrt + "";
+    
+    for (let i = (sqrt | 0); i >= 2; i --)
+        if (n % (i * i) == 0)
+            return i + "√" + (n / (i * i));
+    
+    return "√" + n;
+}
+라는 함수가 있는데 이 함수의 기능은 본래 math.sqrt가 루트 안의 값이 제곱수이든 아니든 전부 루트를 씌운 값을 보냈는데, 이 함수는 제곱수는 루트씌운 값을, 아니면 루트 기호와 그 숫자 자체를 보냅니다.
