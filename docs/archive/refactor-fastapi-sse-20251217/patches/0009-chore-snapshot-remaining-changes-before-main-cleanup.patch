+function TimeConvert(t){
+
+t=parseInt(t)/1000;
+
+hd=t/3600;
+
+hh=parseInt(t/3600);
+
+mmed=(hd-hh)*60;
+
+mm=parseInt((hd-hh)*60);
+
+ss=parseInt((mmed-mm)*60);
+
+result=(hh<1?'':hh+'시간')+
+
+(mm<1?'':' '+mm+'분')+
+
+(ss<1?'':' '+ss+'초');
+
+return result;
+
+}​
