+function codeGen(text) {
+
+  text = text.replace(/\"/g, "\\\"");
+
+  text = text.replace(/만약_/g, "if (");
+
+  text = text.replace(/이가_/g, " ==");
+
+  text = text.replace(/이라면_/g, " ) ");
+
+  text = text.replace(/괄호>/g, "{");
+
+  text = text.replace(/<괄호/g, "}");
+
+  text = text.replace(/전송>/g, "replier.reply(");
+
+  text = text.replace(/<전송/g, ");");
+
+  text = text.replace(/<파싱1/g, ")");
+
+  text = text.replace(/파싱1>/g, "Utils.getWebText(");
+
+  text = text.replace(/지정>/g, "var ");
+
+  text = text.replace(/이것은_/g, " =");
+
+  text = text.replace(/<지정/g, ";");
+
+  text = text.replace(/문자열>/g, "\"");
+
+  text = text.replace(/<문자열/g, "\"");
+
+  text = text.replace(/이것을자른다>/g, ".split(");
+
+  text = text.replace(/<자른다/g, ")");
+
+  text = text.replace(/이것을바꾼다>/g, ".replace(");
+
+  text = text.replace(/이것으로바꾼다>/g, ", ");
+
+  text = text.replace(/<이것으로이것을바꾼다/g, ")");
+
+  text = text.replace(/전부^/g, "g");
+
+  text = text.replace(/ 번째>/g, "[");
+
+  text = text.replace(/<번째/g, "]");
+
+  return text;
+
+}
