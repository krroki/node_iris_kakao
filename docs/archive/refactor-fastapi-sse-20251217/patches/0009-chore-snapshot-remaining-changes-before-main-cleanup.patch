+const scriptName="주사위.js";
+
+
+function response(room, msg, sender, isGroupChat, replier, ImageDB, packageName, threadId){
+
+
+var dice = msg.split(" ");
+ var result
+ if(dice[0]=="/주사위"){
+ if(dice.length==1){
+ result=sender+"님.\n주사위 값은 "+Math.floor(Math.random()*101)+"입니다. (0-100)"
+ }else if(dice.length==2){
+ dice1 = dice[1]*1;
+ if(!isNaN(dice1)){
+ result=sender+"님.\n주사위 값은 "+Math.floor(Math.random()*(dice1+1))+"입니다. (0-"+dice1+")"
+ }else{
+ result="올바른 숫자값을 입력해주세요."
+ }
+ }else if(dice.length==3){
+ if(dice[1]*1<=dice[2]*1){
+ dice1 = dice[1]*1;
+ dice2 = dice[2]*1;
+ }else{
+ dice2 = dice[1]*1;
+ dice1 = dice[2]*1;
+ }
+ if(!isNaN(dice1) && !isNaN(dice2)){
+ result=sender+"님.\n주사위 값은 "+(Math.floor(Math.random()*(dice2-dice1+1))+dice1)+"입니다. ("+dice1+"-"+dice2+")"
+ }else{
+ result="올바른 숫자값을 입력해주세요."
+ }
+ }else{
+ result="올바른 숫자값을 입력해주세요."
+ }
+ replier.reply(result);
+ }
+}
