+result+="\n"
+result+=doc.select("div[class='summary']>div[class='theme']").get(i).text();
+result+="\n"
+result+=doc.select("div[class='summary']>div[class='address']").get(i).text();
+result+="\n\n"
+}
+result=result.trim()
+replier.reply(result)
+}
