+function getWebText(ip, port, host, param) {
+
+  let socketFactory = javax.net.ssl.SSLSocketFactory.getDefault();
+
+  let socket = socketFactory.createSocket(ip, port);
+
+  socket.startHandshake();
+
+  let socketInputStream = socket.getInputStream();
+
+  let socketOutputStream = socket.getOutputStream();
+
+  let inputStreamReader = new java.io.InputStreamReader(socketInputStream);
+
+  let outputStreamWriter = new java.io.OutputStreamWriter(socketOutputStream);
+
+  let bufferedReader = new java.io.BufferedReader(inputStreamReader);
+
+  let bufferedWriter = new java.io.BufferedWriter(outputStreamWriter);
+
+  let req = "";
+
+  req += "GET /" + param + " HTTP/1.1\n";
+
+  req += "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/80.0.3987.163 Whale/2.7.99.22\n";
+
+  req += `Host: " + host + "\n`;
+
+  req += "\n";
+
+  bufferedWriter.write(req);
+
+  bufferedWriter.flush();
+
+  let result = "";
+
+  while ((string = bufferedReader.readLine()) != null) {
+
+    result += string + "\n";
+
+  }
+
+  socket.close();
+
+  return result;
+
+}
